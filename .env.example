# Supabase (optional — without it the app runs fully local, single-device + same-browser tabs)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Ship traffic (optional) — free key from https://aisstream.io
VITE_AISSTREAM_KEY=
# Claude scenario generator (server-side only, never VITE_)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# /api/proxy fetches CORS-less sources (Google My Maps, GDACS, many GIS servers) server-side.
# Private, loopback and link-local addresses are always refused. Leave this empty for local use;
# on a public deployment set it to the hosts you actually need, comma-separated.
PROXY_ALLOW_HOSTS=
